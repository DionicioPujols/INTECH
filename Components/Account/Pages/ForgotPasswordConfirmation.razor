@page "/Account/ForgotPasswordConfirmation"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

<PageTitle>Recuperar contraseña</PageTitle>

<h1>Recuperar contraseña</h1>
<p role="alert">
    Si la cuenta tiene un correo confirmado, recibirás las instrucciones para recuperar tu contraseña.
</p>

<a href="Account/Login">Volver al inicio de sesión</a>
