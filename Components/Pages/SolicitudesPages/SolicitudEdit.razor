@page "/Solicitud/Edit/{SolicitudId:int}"
@attribute [Authorize(Roles = "Técnico")]

@inject SolicitudesService solicitudesService
@inject EstadosSolicitudesService estadosSolicitudesService
@inject NavigationManager navigationManager
@inject ToastService toastService

<PageTitle>Modificar Solicitud</PageTitle>
<EditForm Model="Solicitud" OnValidSubmit="Modificar">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="container">
        <div class="card shadow-lg">
            <div class="card-header text-center">
                <h5 class="card-title">Modificar Solicitud</h5>
            </div>

            <div class="card-body">
                @* Contacto *@
                <div class="mb-3">
                    <label class="form-label" for="Contacto"><strong>Contacto</strong></label>
                    <InputText id="Contacto" class="form-control" @bind-Value="Solicitud.Contacto" maxlength="50"></InputText>
                    <ValidationMessage For="(() => Solicitud.Contacto)" />
                </div>

                @* Dirección *@
                <div class="mb-3">
                    <label class="form-label" for="Direccion"><strong>Dirección</strong></label>
                    <InputText id="Direccion" class="form-control" @bind-Value="Solicitud.Direccion" maxlength="250"></InputText>
                    <ValidationMessage For="(() => Solicitud.Direccion)" />
                </div>

                @* Fecha de solicitud *@
                <div class="mb-3">
                    <label class="form-label" for="FechaSolicitud"><strong>Fecha de solicitud</strong></label>
                    <InputDate id="FechaSolicitud" class="form-control" @bind-Value="Solicitud.FechaSolicitud"></InputDate>
                    <ValidationMessage For="(() => Solicitud.FechaSolicitud)" />
                </div>

                @* Estado *@
                <div class="mb-3">
                    <label class="form-label" for="EstadoSolicitudId"><strong>Estado</strong></label>
                    <InputSelect id="EstadoSolicitudId" class="form-control form-select" @bind-Value="Solicitud.EstadoSolicitudId">
                        <option value="0" disabled>Elija un Estado</option>
                        @foreach (var estadoSolicitud in ListaEstadosSolicitudes)
                        {
                            <option value="@estadoSolicitud.EstadoSolicitudId">@estadoSolicitud.Nombre</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="(() => Solicitud.EstadoSolicitudId)" />
                </div>

                @* Fecha de fin *@
                <div class="mb-3">
                    <label class="form-label" for="FechaFin"><strong>Fecha de fin</strong></label>
                    <InputDate id="FechaFin" class="form-control" @bind-Value="Solicitud.FechaFin"></InputDate>
                    <ValidationMessage For="(() => Solicitud.FechaFin)" />
                </div>

                @* Técnico asignado *@
                <div class="mb-3">
                    <label class="form-label" for="TecnicoAsignado"><strong>Técnico asignado</strong></label>
                    <InputText id="TecnicoAsignado" class="form-control" @bind-Value="Solicitud.TecnicoAsignado" maxlength="150"></InputText>
                    <ValidationMessage For="(() => Solicitud.TecnicoAsignado)" />
                </div>
            </div>

            @* Botones de Acción *@
            <div class="card-footer text-center mt-2">
                <a href="/Solicitud/Index" class="btn btn-secondary">
                    <span class="bi bi-arrow-left"></span> Volver
                </a>
                <button disabled="@(!RendererInfo.IsInteractive)" type="submit" class="btn btn-primary bi bi-floppy"> Modificar</button>
                <button disabled="@(!RendererInfo.IsInteractive)" type="button" class="btn btn-danger bi bi-trash" data-bs-toggle="modal" data-bs-target="#modalEliminarSolicitud"> Eliminar</button>
            </div>
        </div>
    </div>
</EditForm>

@* Modal de eliminación *@
<div class="modal fade" id="modalEliminarSolicitud" tabindex="-1" aria-labelledby="modalEliminarSolicitudLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-5" id="modalEliminarSolicitudLabel">Eliminar Solicitud</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <div class="modal-body">
        ¿Estás seguro de que deseas eliminar esta solicitud?
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button disabled="@(!RendererInfo.IsInteractive)" type="button" class="btn btn-danger" data-bs-dismiss="modal" @onclick="Eliminar">Sí, eliminar</button>
      </div>
    </div>
  </div>
</div>

@code {
    [Parameter]
    public int SolicitudId { get; set; }

    public Solicitudes Solicitud { get; set; } = new Solicitudes();
    public List<EstadosSolicitudes> ListaEstadosSolicitudes { get; set; } = new List<EstadosSolicitudes>();

    protected override async Task OnInitializedAsync()
    {
        var estadosSolicitudesResult = await estadosSolicitudesService.GetList(e => true);
        estadosSolicitudesResult.OnSuccess(estadosSolicitudes => ListaEstadosSolicitudes = estadosSolicitudes);
        estadosSolicitudesResult.OnFailure(() => toastService.ShowError("No se pudieron cargar los estados."));

        var result = await solicitudesService.Buscar(SolicitudId);
        result.OnSuccess(solicitud =>
        {
            if (solicitud is null)
            {
                toastService.ShowError("No se encontró la solicitud.");
                navigationManager.NavigateTo("/Solicitud/Index");
                return;
            }

            Solicitud = solicitud;
        });
        result.OnFailure(() => toastService.ShowError("No se pudo cargar la solicitud."));
    }

    public async Task Modificar()
    {
        Solicitud.Contacto = Solicitud.Contacto?.Trim() ?? string.Empty;
        Solicitud.Direccion = Solicitud.Direccion?.Trim() ?? string.Empty;
        Solicitud.TecnicoAsignado = Solicitud.TecnicoAsignado?.Trim() ?? string.Empty;

        if (Solicitud.FechaFin < Solicitud.FechaSolicitud)
        {
            toastService.ShowError("La fecha de fin no puede ser anterior a la fecha de solicitud.");
            return;
        }

        var result = await solicitudesService.Guardar(Solicitud);
        result.OnSuccess(() =>
        {
            toastService.ShowSuccess("Solicitud modificada correctamente.");
            navigationManager.NavigateTo("/Solicitud/Index");
        });
        result.OnFailure(() => toastService.ShowError("No se pudo modificar la solicitud."));
    }

    private async Task Eliminar()
    {
        var result = await solicitudesService.Eliminar(SolicitudId);
        result.OnSuccess(() =>
        {
            toastService.ShowSuccess("Solicitud eliminada correctamente.");
            navigationManager.NavigateTo("/Solicitud/Index");
        });
        result.OnFailure(() => toastService.ShowError("No se pudo eliminar correctamente"));
    }
}
