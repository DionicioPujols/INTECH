@page "/Solicitud/Index"
@attribute [Authorize(Roles = "Técnico")]

<PageTitle>Solicitudes | INTECH</PageTitle>

<div class="container-fluid p-0">
    <div class="card">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-3">
            <h1 class="h4 fw-normal mb-0">Solicitudes</h1>
            <a href="/Solicitud/Create" class="btn btn-primary d-flex align-items-center gap-2"><span class="bi bi-plus-square" aria-hidden="true"></span> Nueva solicitud</a>
        </div>
        <div class="card-body py-5">
            <p class="text-body-secondary mb-0">No hay solicitudes registradas.</p>
        </div>
        <div class="card-footer">Cantidad: 0</div>
    </div>
</div>
