@inherits LayoutComponentBase

<main class="tecnico-layout login-layout d-flex flex-column flex-lg-row">
    <section class="login-identidad d-flex flex-column align-items-center text-center text-white" aria-label="INTECH Ingeniería y Tecnología Hdez.">
        <div class="login-marca">
            <a href="Account/Login" class="tecnico-marca text-decoration-none">INTECH</a>
            <p class="mb-0">Ingeniería y Tecnología Hdez.</p>
        </div>
        <img src="@Assets["login-equipos.svg"]" alt="" aria-hidden="true" class="login-ilustracion" />
    </section>
    <section class="login-acceso d-flex align-items-center justify-content-center bg-white" aria-label="Acceso al sistema">
        <div class="login-formulario w-100">
            @Body
        </div>
    </section>
</main>
