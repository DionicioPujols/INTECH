@page "/Cliente/Index"
@attribute [Authorize(Roles = "Técnico")]

@inject ClientesService clientesService
@inject ToastService toastService

<PageTitle>Registro de Clientes</PageTitle>
<div class="container">
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-center mb-4">
            <h5 class="card-title">Registro de Clientes</h5>
            <a href="/Cliente/Create" class="btn btn-primary"> <span class="bi bi-plus-square mt-3"></span> Crear Cliente</a>
        </div>

        @* Filtro *@
        <div class="card-body">
            <div class="row">
                <div class="col-3">
                    <label class="col-form-label"><strong>Filtrar por</strong></label>
                </div>
                <div class="col-4">
                    <label class="col-form-label"><strong>B&uacute;squeda</strong></label>
                </div>
            </div>

            @* Controles de Busqueda *@
            <div class="row align-items-center">
                <div class="col-3">
                    <InputSelect class="form-select" @bind-Value="Filtro">
                        <option value="" selected disabled>Elija una opci&oacute;n</option>
                        <option value="ClienteId">ClienteId</option>
                        <option value="Nombre">Nombre</option>
                        <option value="RncCedula">RNC / Cédula</option>
                        <option value="Correo">Correo</option>
                        <option value="Telefono">Teléfono</option>
                        <option value="Direccion">Dirección</option>
                    </InputSelect>
                </div>
                <div class="col-4">
                    <div class="input-group">
                        <input class="form-control" @bind="ValorFiltro" placeholder="Buscar" />
                        <button type="button" class="btn btn-outline-primary bi bi-search" @onclick="Buscar"></button>
                    </div>
                </div>
            </div>

            @* Tabla *@
            <div class="grid">
                <QuickGrid Items="ListaClientes.AsQueryable()" Class="table table-hover mt-3">
                    <PropertyColumn Property="@(c => c.ClienteId)" Title="ClienteId" Sortable="true" />
                    <PropertyColumn Property="@(c => c.Nombre)" Title="Nombre" Sortable="true" />
                    <PropertyColumn Property="@(c => c.RncCedula)" Title="RNC / Cédula" Sortable="true" />
                    <TemplateColumn Title="Teléfono">
                        @context.TelefonosClientes.FirstOrDefault(t => t.EsPrincipal)?.Numero
                    </TemplateColumn>
                    <PropertyColumn Property="@(c => c.Direccion)" Title="Dirección" Sortable="true" />
                    <TemplateColumn Title="Servicios">
                        @context.Solicitudes.Count(s => !s.IsDeleted && s.EstadoSolicitudId == 9)
                    </TemplateColumn>
                    <TemplateColumn Title="Opciones" Align="Align.Center">
                        <div class="d-flex text-nowrap">
                            <a href="/Cliente/Edit/@context.ClienteId" class="btn btn-outline-primary bi bi-pencil-square"></a>
                            <button type="button" class="btn btn-outline-danger bi bi-trash ms-2" data-bs-toggle="modal" data-bs-target="#modalEliminarCliente" @onclick="() => clienteIdAEliminar = context.ClienteId"></button>
                        </div>
                    </TemplateColumn>
                </QuickGrid>
            </div>
        </div>
        <div class="card-footer d-flex justify-content-between align-center mb-4">
            <label>Cantidad:  @ListaClientes.Count()</label>
        </div>
    </div>
</div>

@* Modal de eliminación *@
<div class="modal fade" id="modalEliminarCliente" tabindex="-1" aria-labelledby="modalEliminarClienteLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-5" id="modalEliminarClienteLabel">Eliminar Cliente</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        ¿Estás seguro de que deseas eliminar este cliente?
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-danger" data-bs-dismiss="modal" @onclick="Eliminar">Sí, eliminar</button>
      </div>
    </div>
  </div>
</div>

@code {
    public List<Clientes> ListaClientes { get; set; } = new List<Clientes>();
    public string Filtro { get; set; } = string.Empty;
    public string ValorFiltro { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var clientesResult = await clientesService.GetList(c => true);
        clientesResult.OnSuccess(clientes => ListaClientes = clientes);
        clientesResult.OnFailure(() => toastService.ShowError("No se pudieron consultar los clientes."));
    }

    private async Task Buscar()
    {
        var valor = ValorFiltro.Trim().ToLower();
        if (valor != "")
        {
            if (Filtro == "ClienteId" && int.TryParse(valor, out var clienteId))
            {
                var clientesResult = await clientesService.GetList(c => c.ClienteId == clienteId);
                clientesResult.OnSuccess(clientes => ListaClientes = clientes);
            }
            else if (Filtro == "Nombre")
            {
                var clientesResult = await clientesService.GetList(c => c.Nombre.ToLower().Contains(valor));
                clientesResult.OnSuccess(clientes => ListaClientes = clientes);
            }
            else if (Filtro == "RncCedula")
            {
                var rncCedula = valor.Replace("-", "");
                var clientesResult = await clientesService.GetList(c => c.RncCedula.Contains(rncCedula));
                clientesResult.OnSuccess(clientes => ListaClientes = clientes);
            }
            else if (Filtro == "Correo")
            {
                var clientesResult = await clientesService.GetList(c => c.Correo.ToLower().Contains(valor));
                clientesResult.OnSuccess(clientes => ListaClientes = clientes);
            }
            else if (Filtro == "Telefono")
            {
                var telefono = valor.Replace("-", "");
                var clientesResult = await clientesService.GetList(c => c.TelefonosClientes.Any(t => !t.IsDeleted && t.Numero.Contains(telefono)));
                clientesResult.OnSuccess(clientes => ListaClientes = clientes);
            }
            else if (Filtro == "Direccion")
            {
                var clientesResult = await clientesService.GetList(c => c.Direccion.ToLower().Contains(valor));
                clientesResult.OnSuccess(clientes => ListaClientes = clientes);
            }
        }
        else
        {
            var clientesResult = await clientesService.GetList(c => true);
            clientesResult.OnSuccess(clientes => ListaClientes = clientes);
        }
    }

    private int clienteIdAEliminar;

    private async Task Eliminar()
    {
        var result = await clientesService.Eliminar(clienteIdAEliminar);
        result.OnSuccess(() => toastService.ShowSuccess("Cliente eliminado correctamente."));
        result.OnFailure(() => toastService.ShowError("No se pudo eliminar correctamente"));
        if (result.IsSuccess)
        {
            await Buscar();
        }
    }
}
