@page "/Solicitud/Edit/{SolicitudId:int}"
@attribute [Authorize(Roles = "Técnico")]

@inject SolicitudesService solicitudesService
@inject ClientesService clientesService
@inject NavigationManager navigationManager
@inject ToastService toastService

<PageTitle>Modificar Solicitud</PageTitle>
<EditForm Model="Solicitud" OnValidSubmit="Modificar">
    <DataAnnotationsValidator />

    <div class="container">
        <div class="card shadow-lg">
            <div class="card-header text-center">
                <h5 class="card-title">Modificar Solicitud</h5>
            </div>

            <div class="card-body">

                @* Cliente *@
                <div class="mb-3">
                    <label class="form-label"><strong>Cliente</strong></label>
                    <InputSelect class="form-control form-select" @bind-Value="Solicitud.ClienteId">
                        <option value="0" selected disabled>Elija un Cliente</option>
                        @foreach (var cliente in ListaClientes)
                        {
                            <option value="@cliente.ClienteId">@cliente.Nombre</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="(() => Solicitud.ClienteId)" />
                </div>

                @* Tipo de Servicio *@
                <div class="mb-3">
                    <label class="form-label"><strong>Tipo de Servicio</strong></label>
                    <InputText class="form-control" @bind-Value="Solicitud.TipoServicio" placeholder="Ej.: Instalación de Paneles Solares"></InputText>
                    <ValidationMessage For="(() => Solicitud.TipoServicio)" />
                </div>

                @* Dirección del Servicio *@
                <div class="mb-3">
                    <label class="form-label"><strong>Dirección del Servicio</strong></label>
                    <InputText class="form-control" @bind-Value="Solicitud.Direccion" placeholder="Ej.: Calle Principal #12, Santiago"></InputText>
                    <ValidationMessage For="(() => Solicitud.Direccion)" />
                </div>

                @* Fecha de Solicitud *@
                <div class="mb-3">
                    <label class="form-label"><strong>Fecha de Solicitud</strong></label>
                    <InputDate class="form-control" @bind-Value="Solicitud.FechaSolicitud"></InputDate>
                    <ValidationMessage For="(() => Solicitud.FechaSolicitud)" />
                </div>

            </div>

            @* Botones de Acción *@
            <div class="card-footer text-center mt-2">
                <a href="/Solicitud/Index" class="btn btn-secondary">
                    <span class="bi bi-arrow-left"></span> Volver
                </a>
                <button type="submit" class="btn btn-primary bi bi-floppy"> Modificar</button>
                <button type="button" class="btn btn-danger bi bi-trash" data-bs-toggle="modal" data-bs-target="#modalEliminarSolicitud"> Eliminar</button>
            </div>
        </div>
    </div>
</EditForm>

@* Modal de eliminación *@
<div class="modal fade" id="modalEliminarSolicitud" tabindex="-1" aria-labelledby="modalEliminarSolicitudLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-5" id="modalEliminarSolicitudLabel">Eliminar Solicitud</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        ¿Estás seguro de que deseas eliminar esta solicitud?
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-danger" data-bs-dismiss="modal" @onclick="Eliminar">Sí, eliminar</button>
      </div>
    </div>
  </div>
</div>

@code {
    [Parameter]
    public int SolicitudId { get; set; }

    public Solicitudes Solicitud { get; set; } = new Solicitudes();
    public List<Clientes> ListaClientes { get; set; } = new List<Clientes>();

    protected override async Task OnInitializedAsync()
    {
        var result = await solicitudesService.Buscar(SolicitudId);
        result.OnSuccess(solicitud => Solicitud = solicitud ?? new Solicitudes());

        var clientesResult = await clientesService.GetList(c => true);
        clientesResult.OnSuccess(clientes => ListaClientes = clientes);
        clientesResult.OnFailure(() => toastService.ShowError("No se pudieron consultar los clientes."));
    }

    public async Task Modificar()
    {
        Solicitud.TipoServicio = Solicitud.TipoServicio.Trim();
        Solicitud.Direccion = Solicitud.Direccion.Trim();

        var result = await solicitudesService.Guardar(Solicitud);
        result.OnSuccess(() =>
        {
            toastService.ShowSuccess("Solicitud modificada correctamente.");
            navigationManager.NavigateTo("/Solicitud/Index");
        });
        result.OnFailure(() => toastService.ShowError("No se pudo modificar la solicitud."));
    }

    private async Task Eliminar()
    {
        var result = await solicitudesService.Eliminar(SolicitudId);
        result.OnSuccess(() =>
        {
            toastService.ShowSuccess("Solicitud eliminada correctamente.");
            navigationManager.NavigateTo("/Solicitud/Index");
        });
        result.OnFailure(() => toastService.ShowError("No se pudo eliminar la solicitud."));
    }
}
