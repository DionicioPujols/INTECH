@page "/Solicitud/Index"
@attribute [Authorize(Roles = "Técnico")]

@inject SolicitudesService solicitudesService
@inject ToastService toastService

<PageTitle>Registro de Solicitudes</PageTitle>
<div class="container">
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-center mb-4">
            <h5 class="card-title">Registro de Solicitudes</h5>
            <a href="/Solicitud/Create" class="btn btn-primary"> <span class="bi bi-plus-square mt-3"></span> Crear</a>
        </div>

        <div class="card-body">
            @* Filtro *@
            <div class="row">
                <div class="col-3">
                    <label class="col-form-label"><strong>Filtrar por</strong></label>
                </div>
                <div class="col-4">
                    <label class="col-form-label"><strong>Búsqueda</strong></label>
                </div>
            </div>

            @* Controles de búsqueda *@
            <div class="row align-items-center">
                <div class="col-3">
                    <InputSelect class="form-select" @bind-Value="Filtro">
                        <option value="" selected disabled>Elija una opci&oacute;n</option>
                        <option value="SolicitudId">SolicitudId</option>
                        <option value="Cliente">Cliente</option>
                        <option value="TipoServicio">Tipo de Servicio</option>
                        <option value="Estado">Estado</option>
                        <option value="Fecha">Fecha</option>
                    </InputSelect>
                </div>
                <div class="col-4">
                    <div class="input-group">
                        <input class="form-control" @bind="ValorFiltro" placeholder="Buscar" />
                        <button type="button" class="btn btn-outline-primary bi bi-search" @onclick="Buscar"></button>
                    </div>
                </div>
            </div>
            <div class="row mt-3">
                <div class="col-3">
                    <label class="col-form-label"><strong>Desde</strong></label>
                    <InputDate class="form-control" @bind-Value="Desde"></InputDate>
                </div>
                <div class="col-3">
                    <label class="col-form-label"><strong>Hasta</strong></label>
                    <InputDate class="form-control" @bind-Value="Hasta"></InputDate>
                </div>
            </div>

            @* Tabla *@
            <div class="grid">
                <QuickGrid Items="ListaSolicitudes.AsQueryable()" Class="table table-hover mt-3">
                    <PropertyColumn Property="@(s => s.SolicitudId)" Title="SolicitudId" Sortable="true" />
                    <PropertyColumn Property="@(s => s.Cliente.Nombre)" Title="Cliente" Sortable="true" />
                    <PropertyColumn Property="@(s => s.TipoServicio)" Title="Tipo de Servicio" Sortable="true" />
                    <PropertyColumn Property="@(s => s.FechaSolicitud)" Title="Fecha de Solicitud" Format="dd/MM/yyyy" Sortable="true" />
                    <TemplateColumn Title="Estado">
                        <span class="badge @ObtenerColorEstado(context.EstadoSolicitudId)">@context.EstadoSolicitud.Nombre</span>
                    </TemplateColumn>
                    <TemplateColumn Title="Opciones" Align="Align.Center">
                        <div class="d-flex text-nowrap">
                            <button type="button" class="btn btn-outline-primary bi bi-eye"
                                    data-bs-toggle="modal" data-bs-target="#modalDetalleSolicitud"
                                    @onclick="() => SolicitudSeleccionada = context"></button>
                            <a href="/Solicitud/Edit/@context.SolicitudId" class="btn btn-outline-primary bi bi-pencil-square ms-2"></a>
                            <button type="button" class="btn btn-outline-danger bi bi-trash ms-2"
                                    data-bs-toggle="modal" data-bs-target="#modalEliminarSolicitud"
                                    @onclick="() => solicitudIdAEliminar = context.SolicitudId"></button>
                        </div>
                    </TemplateColumn>
                </QuickGrid>
            </div>
        </div>

        <div class="card-footer d-flex justify-content-between align-center mb-4">
            <label>Cantidad:  @ListaSolicitudes.Count</label>
        </div>
    </div>
</div>

@* Modal de detalle *@
<div class="modal fade" id="modalDetalleSolicitud" tabindex="-1" aria-labelledby="modalDetalleSolicitudLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <div>
          <h1 class="modal-title fs-5" id="modalDetalleSolicitudLabel">Detalle de la Solicitud</h1>
          <small class="text-body-secondary">Solicitud @SolicitudSeleccionada.SolicitudId</small>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="row g-3">
          <div class="col-12 col-md-6">
            <div class="border rounded bg-light p-3 h-100">
              <small class="text-uppercase text-body-secondary fw-bold">Cliente</small>
              <p class="mb-0 fw-semibold">@SolicitudSeleccionada.Cliente?.Nombre</p>
            </div>
          </div>
          <div class="col-12 col-md-6">
            <div class="border rounded bg-light p-3 h-100">
              <small class="text-uppercase text-body-secondary fw-bold">Contacto</small>
              <p class="mb-0 fw-semibold">@SolicitudSeleccionada.Cliente?.TelefonosClientes.FirstOrDefault(t => t.EsPrincipal)?.Numero</p>
            </div>
          </div>
          <div class="col-12 col-md-6">
            <div class="border rounded bg-light p-3 h-100">
              <small class="text-uppercase text-body-secondary fw-bold">Tipo de Servicio</small>
              <p class="mb-0 fw-semibold">@SolicitudSeleccionada.TipoServicio</p>
            </div>
          </div>
          <div class="col-12 col-md-6">
            <div class="border rounded bg-light p-3 h-100">
              <small class="text-uppercase text-body-secondary fw-bold">Dirección</small>
              <p class="mb-0 fw-semibold">@SolicitudSeleccionada.Direccion</p>
            </div>
          </div>
          <div class="col-12 col-md-6">
            <div class="border rounded bg-light p-3 h-100">
              <small class="text-uppercase text-body-secondary fw-bold">Fecha de Solicitud</small>
              <p class="mb-0 fw-semibold">@SolicitudSeleccionada.FechaSolicitud.ToString("dd/MM/yyyy")</p>
            </div>
          </div>
          <div class="col-12 col-md-6">
            <div class="border rounded bg-light p-3 h-100">
              <small class="text-uppercase text-body-secondary fw-bold">Estado</small>
              <p class="mb-0 fw-semibold">@SolicitudSeleccionada.EstadoSolicitud?.Nombre</p>
            </div>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
      </div>
    </div>
  </div>
</div>

@* Modal de eliminación *@
<div class="modal fade" id="modalEliminarSolicitud" tabindex="-1" aria-labelledby="modalEliminarSolicitudLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-5" id="modalEliminarSolicitudLabel">Eliminar Solicitud</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        ¿Estás seguro de que deseas eliminar esta solicitud?
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-danger" data-bs-dismiss="modal" @onclick="Eliminar">Sí, eliminar</button>
      </div>
    </div>
  </div>
</div>

@code {
    public List<Solicitudes> ListaSolicitudes { get; set; } = new List<Solicitudes>();
    public Solicitudes SolicitudSeleccionada { get; set; } = new Solicitudes();
    public string Filtro { get; set; } = string.Empty;
    public string ValorFiltro { get; set; } = string.Empty;
    public DateTime? Desde { get; set; }
    public DateTime? Hasta { get; set; }
    private int solicitudIdAEliminar;

    protected override async Task OnInitializedAsync()
    {
        await CargarSolicitudes();
        Desde = null;
        Hasta = null;
    }

    private async Task CargarSolicitudes()
    {
        var solicitudesResult = await solicitudesService.GetList(s => true);
        solicitudesResult.OnSuccess(solicitudes => ListaSolicitudes = solicitudes);
        solicitudesResult.OnFailure(() => toastService.ShowError("No se pudieron consultar las solicitudes."));
    }

    private string ObtenerColorEstado(int estadoSolicitudId)
    {
        if (estadoSolicitudId == 2)
        {
            return "text-bg-success";
        }
        else if (estadoSolicitudId == 3)
        {
            return "text-bg-danger";
        }

        return "text-bg-warning";
    }

    private async Task Eliminar()
    {
        var result = await solicitudesService.Eliminar(solicitudIdAEliminar);
        result.OnSuccess(() => toastService.ShowSuccess("Solicitud eliminada correctamente."));
        result.OnFailure(() => toastService.ShowError("No se pudo eliminar la solicitud."));

        if (result.IsSuccess)
        {
            await CargarSolicitudes();
        }
    }

    private async Task Buscar()
    {
        var valor = ValorFiltro.Trim().ToLower();
        if (Filtro == "Fecha")
        {
            if (Desde == null || Hasta == null)
            {
                toastService.ShowError("Seleccione las fechas desde y hasta.");
                return;
            }

            if (Desde > Hasta)
            {
                toastService.ShowWarning("La fecha desde no puede ser mayor que la fecha hasta.");
                return;
            }

            var solicitudesPorFechaResult = await solicitudesService.GetList(s =>
                s.FechaSolicitud >= Desde && s.FechaSolicitud <= Hasta);
            solicitudesPorFechaResult.OnSuccess(solicitudes => ListaSolicitudes = solicitudes);
            solicitudesPorFechaResult.OnFailure(() =>
                toastService.ShowError("No se pudieron consultar las solicitudes."));
        }
        else if (valor == "")
        {
            await CargarSolicitudes();
        }
        else if (Filtro == "SolicitudId")
        {
            if (!int.TryParse(valor, out var solicitudId))
            {
                toastService.ShowError("Ingrese un número de solicitud válido.");
                return;
            }

            var solicitudesPorIdResult = await solicitudesService.GetList(s => s.SolicitudId == solicitudId);
            solicitudesPorIdResult.OnSuccess(solicitudes => ListaSolicitudes = solicitudes);
            solicitudesPorIdResult.OnFailure(() =>
                toastService.ShowError("No se pudieron consultar las solicitudes."));
        }
        else if (Filtro == "Cliente")
        {
            var solicitudesPorClienteResult = await solicitudesService.GetList(s => s.Cliente.Nombre.ToLower().Contains(valor));
            solicitudesPorClienteResult.OnSuccess(solicitudes => ListaSolicitudes = solicitudes);
            solicitudesPorClienteResult.OnFailure(() =>
                toastService.ShowError("No se pudieron consultar las solicitudes."));
        }
        else if (Filtro == "TipoServicio")
        {
            var solicitudesPorTipoResult = await solicitudesService.GetList(s => s.TipoServicio.ToLower().Contains(valor));
            solicitudesPorTipoResult.OnSuccess(solicitudes => ListaSolicitudes = solicitudes);
            solicitudesPorTipoResult.OnFailure(() =>
                toastService.ShowError("No se pudieron consultar las solicitudes."));
        }
        else if (Filtro == "Estado")
        {
            var solicitudesPorEstadoResult = await solicitudesService.GetList(s => s.EstadoSolicitud.Nombre.ToLower().Contains(valor));
            solicitudesPorEstadoResult.OnSuccess(solicitudes => ListaSolicitudes = solicitudes);
            solicitudesPorEstadoResult.OnFailure(() =>
                toastService.ShowError("No se pudieron consultar las solicitudes."));
        }
        else
        {
            toastService.ShowError("Seleccione un filtro.");
        }
    }
}
