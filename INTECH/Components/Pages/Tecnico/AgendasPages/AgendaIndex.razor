@page "/Agenda/Index"
@attribute [Authorize(Roles = "Técnico")]

@inject AgendasService agendasService
@inject Microsoft.AspNetCore.Identity.UserManager<INTECH.Data.ApplicationUser> userManager
@inject ToastService toastService

<PageTitle>Agenda</PageTitle>
<div class="container-fluid p-0">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h3 class="fw-bold mb-0">Agenda</h3>
            <p class="text-body-secondary mb-0">Visitas programadas y su ubicación.</p>
        </div>
        <a href="/Agenda/Create" class="btn btn-primary"> <span class="bi bi-plus-square"></span> Nueva visita</a>
    </div>

    <div class="row g-3">
        <div class="col-12 col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    @* Filtros *@
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                        <div>
                            <InputSelect class="form-select" @bind-Value="VistaActual">
                                <option value="@VistaAgenda.Hoy">Hoy</option>
                                <option value="@VistaAgenda.Semanal">Semanal</option>
                                <option value="@VistaAgenda.Mensual">Mensual</option>
                            </InputSelect>
                        </div>
                        <div>
                            <input class="form-control" @bind="SolicitudIdFiltro" placeholder="ID de solicitud" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>