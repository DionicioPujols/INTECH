@page "/Agenda/Index"
@attribute [Authorize(Roles = "Técnico")]

@inject AgendasService agendasService
@inject Microsoft.AspNetCore.Identity.UserManager<INTECH.Data.ApplicationUser> userManager
@inject ToastService toastService

<PageTitle>Agenda</PageTitle>
<div class="container-fluid p-0">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h3 class="fw-bold mb-0">Agenda</h3>
            <p class="text-body-secondary mb-0">Visitas programadas y su ubicación.</p>
        </div>
        <a href="/Agenda/Create" class="btn btn-primary"> <span class="bi bi-plus-square"></span> Nueva visita</a>
    </div>

    <div class="row g-3">
        <div class="col-12 col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    @* Filtros *@
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                        <div>
                            <InputSelect class="form-select" @bind-Value="VistaActual">
                                <option value="@VistaAgenda.Hoy">Hoy</option>
                                <option value="@VistaAgenda.Semanal">Semanal</option>
                                <option value="@VistaAgenda.Mensual">Mensual</option>
                            </InputSelect>
                        </div>
                        <div>
                            <input class="form-control" @bind="SolicitudIdFiltro" placeholder="ID de solicitud" />
                        </div>
                        <div>
                            <InputSelect class="form-select" @bind-Value="TecnicoFiltroId">
                                <option value="">Todos los técnicos</option>
                                <option value="SIN_ASIGNAR">Sin asignar</option>
                                @foreach (var tecnico in ListaTecnicos)
                                {
                                    <option value="@tecnico.Id">@tecnico.UserName</option>
                                }
                            </InputSelect>
                        </div>
                        <button type="button" class="btn btn-primary" @onclick="Buscar">Buscar</button>
                    </div>

                    @* Navegación del periodo *@
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="Anterior">
                            <span class="bi bi-chevron-left"></span>
                        </button>
                        <span class="fw-medium text-capitalize">@TituloPeriodo</span>
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="Siguiente">
                            <span class="bi bi-chevron-right"></span>
                        </button>
                        <button type="button" class="btn btn-outline-primary btn-sm ms-auto" @onclick="IrAHoy">Hoy</button>
                    </div>
                    @* Calendario *@
                    @if (VistaActual == VistaAgenda.Hoy)
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0 align-middle">
                                <tbody>
                                    @for (int hora = 8; hora <= 18; hora++)
                                    {
                                        var horaActual = hora;
                                        var visitasHora = ListaAgendas
                                            .Where(a => a.Fecha.Date == FechaReferencia.Date && a.HoraInicio.Hour == horaActual)
                                            .OrderBy(a => a.HoraInicio)
                                            .ToList();

                                        <tr>
                                            <td class="text-body-secondary small fc-col-hora">@($"{(horaActual > 12 ? horaActual - 12 : horaActual):00} {(horaActual >= 12 ? "PM" : "AM")}")</td>
                                            <td class="fc-slot-cell">
                                                <div class="d-flex flex-column gap-1">
                                                    @foreach (var visita in visitasHora)
                                                    {
                                                        <div class="badge bg-primary text-start fw-normal py-2 px-2 fc-event-item"
                                                             @onclick="() => SeleccionarVisita(visita)">
                                                            <span class="fw-bold">@visita.HoraInicio.ToString("hh:mm tt") - @visita.HoraFin.ToString("hh:mm tt")</span>
                                                            | Solicitud #@visita.SolicitudId - @visita.Solicitud.Cliente.Nombre (@visita.Solicitud.Direccion)
                                                        </div>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else if (VistaActual == VistaAgenda.Semanal)
                    {
                        var diasSemana = ObtenerDiasSemana();

                        <div class="table-responsive">
                            <table class="table table-bordered mb-0 align-middle">
                                <thead class="table-light text-center">
                                    <tr>
                                        <th class="fc-col-hora">Hora</th>
                                        @foreach (var dia in diasSemana)
                                        {
                                            var esHoy = dia.Date == DateTime.Today;
                                            <th class="@(esHoy ? "table-primary" : "")">
                                                <div class="small text-uppercase text-muted">@dia.ToString("ddd", Cultura)</div>
                                                <div class="fs-6">@dia.Day</div>
                                            </th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int hora = 8; hora <= 18; hora++)
                                    {
                                        var horaActual = hora;
                                        <tr>
                                            <td class="text-center text-muted small bg-light">@($"{horaActual:00}:00")</td>
                                            @foreach (var dia in diasSemana)
                                            {
                                                var visitasHora = ListaAgendas
                                                    .Where(a => a.Fecha.Date == dia.Date && a.HoraInicio.Hour == horaActual)
                                                    .OrderBy(a => a.HoraInicio)
                                                    .ToList();

                                                <td class="p-1 fc-slot-cell">
                                                    @foreach (var visita in visitasHora)
                                                    {
                                                        <div class="badge bg-primary d-block text-start text-truncate mb-1 p-1 fc-event-item"
                                                             @onclick="() => SeleccionarVisita(visita)">
                                                            @visita.HoraInicio.ToString("HH:mm") - #@visita.SolicitudId @visita.Solicitud.Cliente.Nombre
                                                        </div>
                                                    }
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="fc-grid-7 bg-light border-top border-bottom text-center fw-semibold text-muted small py-2">
                            @foreach (var diaNombre in NombresDias)
                            {
                                <div>@diaNombre</div>
                            }
                        </div>

                        <div class="fc-grid-7 border-start">
                            @foreach (var fecha in ObtenerDiasMes())
                            {
                                var esMesActual = fecha.Month == FechaReferencia.Month;
                                var esHoy = fecha.Date == DateTime.Today;
                                var visitasDia = ListaAgendas
                                    .Where(a => a.Fecha.Date == fecha.Date)
                                    .OrderBy(a => a.HoraInicio)
                                    .ToList();

                                <div class="fc-day-cell border-end border-bottom p-2 @(esMesActual ? "bg-white" : "bg-light text-muted")">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="badge rounded-pill @(esHoy ? "bg-primary" : "text-dark fw-normal")">
                                            @fecha.Day
                                        </span>
                                        @if (visitasDia.Count > 3)
                                        {
                                            <small class="text-muted fc-more-label">+@((visitasDia.Count - 3)) más</small>
                                        }
                                    </div>

                                    <div class="d-flex flex-column gap-1">
                                        @foreach (var visita in visitasDia.Take(3))
                                        {
                                            <div class="badge bg-primary text-start text-truncate fw-normal py-1 px-2 fc-event-item"
                                                 @onclick="() => SeleccionarVisita(visita)">
                                                <span class="fw-bold">@visita.HoraInicio.ToString("HH:mm")</span> #@visita.SolicitudId @visita.Solicitud.Cliente.Nombre
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
        @* Panel de detalle de la visita seleccionada *@
        <div class="col-12 col-lg-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    @if (VisitaSeleccionada == null)
                    {
                        <p class="text-body-secondary text-center mb-0 py-4">Selecciona una visita del calendario para ver su detalle.</p>
                    }
                    else
                    {
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="card-title mb-0">Solicitud #@VisitaSeleccionada.SolicitudId</h5>
                            <span class="badge @ObtenerColorEstado(VisitaSeleccionada.Solicitud.EstadoSolicitudId)">
                                @VisitaSeleccionada.Solicitud.EstadoSolicitud.Nombre
                            </span>
                        </div>

                        <div class="mb-2">
                            <small class="text-body-secondary d-block">Cliente</small>
                            <strong>@VisitaSeleccionada.Solicitud.Cliente.Nombre</strong>
                        </div>
                        <div class="mb-2">
                            <small class="text-body-secondary d-block">Tipo de servicio</small>
                            <span>@VisitaSeleccionada.Solicitud.TipoServicio</span>
                        </div>
                        <div class="mb-2">
                            <small class="text-body-secondary d-block">Dirección</small>
                            <span>@VisitaSeleccionada.Solicitud.Direccion</span>
                        </div>
                        <div class="mb-2">
                            <small class="text-body-secondary d-block">Fecha</small>
                            <span>@VisitaSeleccionada.Fecha.ToString("dd/MM/yyyy")</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>