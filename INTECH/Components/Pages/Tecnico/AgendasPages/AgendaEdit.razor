@page "/Agenda/Edit/{AgendaId:int}"
@attribute [Authorize(Roles = "Técnico")]

@inject AgendasService agendasService
@inject SolicitudesService solicitudesService
@inject Microsoft.AspNetCore.Identity.UserManager<INTECH.Data.ApplicationUser> userManager
@inject NavigationManager navigationManager
@inject ToastService toastService

<PageTitle>Modificar Visita</PageTitle>
<EditForm Model="Agenda" OnValidSubmit="Modificar">
    <DataAnnotationsValidator />

    <div class="container">
        <div class="card shadow-lg">
            <div class="card-header text-center">
                <h5 class="card-title">Modificar Visita</h5>
            </div>

            <div class="card-body">
            </div>
        </div>
    </div>
</EditForm>