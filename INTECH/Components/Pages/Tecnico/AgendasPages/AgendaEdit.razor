@page "/Agenda/Edit/{AgendaId:int}"
@attribute [Authorize(Roles = "Técnico")]

@inject AgendasService agendasService
@inject SolicitudesService solicitudesService
@inject Microsoft.AspNetCore.Identity.UserManager<INTECH.Data.ApplicationUser> userManager
@inject NavigationManager navigationManager
@inject ToastService toastService

<PageTitle>Modificar Visita</PageTitle>
<EditForm Model="Agenda" OnValidSubmit="Modificar">
    <DataAnnotationsValidator />

    <div class="container">
        <div class="card shadow-lg">
            <div class="card-header text-center">
                <h5 class="card-title">Modificar Visita</h5>
            </div>

            <div class="card-body">
                @* Solicitud *@
                <div class="mb-3">
                    <label class="form-label"><strong>Solicitud *</strong></label>
                    <InputSelect class="form-control form-select" @bind-Value="Agenda.SolicitudId" @bind-Value:after="CargarDireccion">
                        <option value="0" disabled>Seleccionar solicitud...</option>
                        @foreach (var solicitud in ListaSolicitudes)
                        {
                            <option value="@solicitud.SolicitudId">Solicitud #@solicitud.SolicitudId - @solicitud.Cliente.Nombre (@solicitud.TipoServicio)</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="(() => Agenda.SolicitudId)" />
                </div>
            </div>
        </div>
    </div>
</EditForm>